# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arquivo "nul" criado por engano no Windows (cmd > nul no Git Bash)
nul

# Capturas e logs gerados pelo Playwright MCP durante a verificação de telas
.playwright-mcp/

# Capturas de revisão de design (impeccable): mostram dados reais da gráfica
.impeccable/review/

# Protótipo local do modal de O.S.: o catálogo embutido tem preços reais.
# A versão publicada fica em public/prototipos/novaos.html, sem dados.
prototipo-modal-os/
